{
  "schema": "test10a-evidence-policy-v1",
  "encoding": "utf-8",
  "root": "work/test10/runs/{runId}/evidence",
  "writeOnceFiles": [
    "manifest.json",
    "manifest.sha256.json",
    "fixture-summary.json",
    "cleanup-receipt.json",
    "cleanup-receipt.sha256.json",
    "case-01.json",
    "case-02.json",
    "case-03.json",
    "case-04.json",
    "case-05.json",
    "case-06.json",
    "case-07.json",
    "case-08.json",
    "case-09.json"
  ],
  "allowedCaseStatus": ["PASS", "FAIL", "BLOCKED"],
  "allowedEvidence": [
    "manifest",
    "hash-summary",
    "safe-fixture-summary",
    "cleanup-receipt",
    "case-result",
    "derived-observer-output"
  ],
  "forbiddenEvidence": [
    "raw-screenshot",
    "post-capture-redaction",
    "har",
    "console-dump",
    "clipboard",
    "secret-value",
    "personal-data",
    "real-contact",
    "response-body",
    "raw-header",
    "cookie",
    "token",
    "query",
    "fragment"
  ],
  "maximumFileBytes": 1048576,
  "maximumEvidenceBytes": 16777216,
  "cleanupMayDeleteEvidenceRoot": false,
  "retainUntilIndependentReconciliation": true
}
